NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=social_db
DB_SYNCHRONIZE=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-southeast-1

# AWS DynamoDB
AWS_DYNAMODB_CHAT_TABLE_NAME=social-chat-table
AWS_DYNAMODB_AUDIT_LOG_TABLE_NAME=social-audit-logs
AWS_DYNAMODB_TABLE_NAME=social-chat-table
AWS_DYNAMODB_REGION=ap-southeast-1

# AWS SES (Mail)
AWS_SES_FROM_EMAIL=
AWS_SES_REGION=ap-southeast-1

# AWS Lambda
AWS_LAMBDA_REGION=ap-southeast-1

# AWS API Gateway WebSocket
AWS_WEBSOCKET_ENDPOINT=
AWS_WEBSOCKET_MANAGEMENT_ENDPOINT=
